<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ca-radar — Portfolio Report</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg:        #f8f9fb;
      --surface:   #ffffff;
      --border:    #e2e6ea;
      --text:      #1a1d23;
      --text-muted:#6b7280;
      --accent:    #2563eb;
      --critical:  #dc2626;
      --high:      #d97706;
      --medium:    #ca8a04;
      --low:       #2563eb;
      --info:      #6b7280;
      --ok:        #16a34a;
      --radius:    8px;
      --shadow:    0 1px 3px rgba(0,0,0,.08);
      --shadow-lg: 0 4px 16px rgba(0,0,0,.10);
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      font-size: 14px;
      background: var(--bg);
      color: var(--text);
      line-height: 1.5;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* ── Header ─────────────────────────────────────────────────────── */
    .header {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 0 24px;
      position: sticky; top: 0; z-index: 100;
      box-shadow: var(--shadow);
    }
    .header-inner {
      max-width: 1280px; margin: 0 auto;
      display: flex; align-items: center; gap: 24px; padding: 14px 0;
    }
    .brand { font-size: 18px; font-weight: 700; color: var(--accent); letter-spacing: -.5px; flex-shrink: 0; }
    .brand span { color: var(--text-muted); font-weight: 400; }
    .header-meta { flex: 1; }
    .header-meta h1 { font-size: 15px; font-weight: 600; }
    .header-meta p  { font-size: 12px; color: var(--text-muted); }

    /* ── Page ────────────────────────────────────────────────────────── */
    .page { max-width: 1280px; margin: 0 auto; padding: 0 24px 64px; }

    /* ── Stat cards ──────────────────────────────────────────────────── */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      padding: 28px 0 0;
    }
    .stat-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 18px 20px;
    }
    .stat-card .stat-num  { font-size: 30px; font-weight: 700; line-height: 1; }
    .stat-card .stat-label { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: .4px; margin-top: 4px; }

    /* ── Table ───────────────────────────────────────────────────────── */
    .table-section { margin-top: 28px; }
    .table-section h2 { font-size: 16px; font-weight: 600; margin-bottom: 16px; }
    .table-wrap {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
    }
    table { width: 100%; border-collapse: collapse; }
    thead th {
      background: var(--bg);
      padding: 10px 16px;
      text-align: left;
      font-size: 11px; font-weight: 600;
      text-transform: uppercase; letter-spacing: .4px;
      color: var(--text-muted);
      border-bottom: 1px solid var(--border);
      cursor: pointer;
      user-select: none;
      white-space: nowrap;
    }
    thead th:hover { color: var(--text); }
    thead th .sort-icon { margin-left: 4px; opacity: .4; }
    thead th.sorted-asc .sort-icon::after   { content: " ▲"; opacity: 1; }
    thead th.sorted-desc .sort-icon::after  { content: " ▼"; opacity: 1; }
    tbody tr { border-bottom: 1px solid var(--border); transition: background .1s; }
    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: var(--bg); }
    tbody td { padding: 11px 16px; vertical-align: middle; }

    .tenant-name { font-weight: 600; }
    .tenant-id   { font-size: 11px; color: var(--text-muted); font-family: monospace; }
    .score-cell  { text-align: center; }
    .score-pill  {
      display: inline-flex; align-items: center; justify-content: center;
      width: 48px; height: 28px;
      border-radius: 6px; font-weight: 700; font-size: 13px;
    }
    .score-ok   { background: #dcfce7; color: var(--ok); }
    .score-warn { background: #fefce8; color: var(--medium); }
    .score-bad  { background: #fef2f2; color: var(--critical); }

    .count-cell { text-align: right; font-variant-numeric: tabular-nums; }
    .crit  { color: var(--critical); font-weight: 600; }
    .high  { color: var(--high);     font-weight: 600; }
    .med   { color: var(--medium); }
    .low-c { color: var(--low); }

    /* ── Sparkline ───────────────────────────────────────────────────── */
    .sparkline { display: block; }

    /* ── Last scan ───────────────────────────────────────────────────── */
    .last-scan { font-size: 12px; color: var(--text-muted); white-space: nowrap; }

    /* ── Footer ─────────────────────────────────────────────────────── */
    .footer {
      margin-top: 48px; padding-top: 24px;
      border-top: 1px solid var(--border);
      text-align: center; font-size: 11px; color: var(--text-muted);
    }

    /* ── Empty state ─────────────────────────────────────────────────── */
    .empty-state {
      padding: 64px; text-align: center;
      color: var(--text-muted); font-size: 15px;
    }
  </style>
</head>
<body>

<!-- Header -->
<div class="header">
  <div class="header-inner">
    <div class="brand">ca<span>-</span>radar</div>
    <div class="header-meta">
      <h1>Portfolio Report</h1>
      <p>Generated {{ captured_at }}{% if tool_version %} &nbsp;·&nbsp; v{{ tool_version }}{% endif %}</p>
    </div>
  </div>
</div>

<div class="page">

  <!-- Stat cards -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-num">{{ total_tenants }}</div>
      <div class="stat-label">Tenants scanned</div>
    </div>
    {% set avg_col = "var(--ok)" if avg_score >= 80 else ("var(--medium)" if avg_score >= 50 else "var(--critical)") %}
    <div class="stat-card">
      <div class="stat-num" style="color:{{ avg_col }}">{{ avg_score }}</div>
      <div class="stat-label">Avg posture score</div>
    </div>
    <div class="stat-card">
      <div class="stat-num" style="color:var(--critical)">{{ total_critical }}</div>
      <div class="stat-label">🔴 Critical findings</div>
    </div>
    <div class="stat-card">
      <div class="stat-num" style="color:var(--high)">{{ total_high }}</div>
      <div class="stat-label">🟠 High findings</div>
    </div>
  </div>

  <!-- Tenant table -->
  <div class="table-section">
    <h2>Tenants</h2>
    {% if not rows %}
    <div class="table-wrap">
      <div class="empty-state">No tenant scans recorded yet.</div>
    </div>
    {% else %}
    <div class="table-wrap">
      <table id="portfolio-table">
        <thead>
          <tr>
            <th onclick="sortTable(0)" data-col="0">Tenant<span class="sort-icon"></span></th>
            <th onclick="sortTable(1)" data-col="1" style="text-align:center">Score<span class="sort-icon"></span></th>
            <th onclick="sortTable(2)" data-col="2" style="text-align:right">🔴 Crit<span class="sort-icon"></span></th>
            <th onclick="sortTable(3)" data-col="3" style="text-align:right">🟠 High<span class="sort-icon"></span></th>
            <th onclick="sortTable(4)" data-col="4" style="text-align:right">🟡 Med<span class="sort-icon"></span></th>
            <th onclick="sortTable(5)" data-col="5" style="text-align:right">Total<span class="sort-icon"></span></th>
            <th>Trend ({{ rows[0].trend_scores | length if rows else 0 }} scans)</th>
            <th onclick="sortTable(7)" data-col="7">Last scan<span class="sort-icon"></span></th>
            <th>Report</th>
          </tr>
        </thead>
        <tbody>
          {% for row in rows %}
          {% set sc = row.latest_posture_score %}
          {% if sc >= 80 %}{% set sc_cls = "score-ok" %}
          {% elif sc >= 50 %}{% set sc_cls = "score-warn" %}
          {% else %}{% set sc_cls = "score-bad" %}{% endif %}
          <tr>
            <td>
              <div class="tenant-name">{{ row.tenant_id }}</div>
              <div class="tenant-id">{{ row.scan_count }} scan{{ "s" if row.scan_count != 1 else "" }}</div>
            </td>
            <td class="score-cell" data-val="{{ sc }}">
              <span class="score-pill {{ sc_cls }}">{{ sc }}</span>
            </td>
            <td class="count-cell" data-val="{{ row.latest_critical }}">
              {% if row.latest_critical %}<span class="crit">{{ row.latest_critical }}</span>{% else %}<span style="color:var(--text-muted)">—</span>{% endif %}
            </td>
            <td class="count-cell" data-val="{{ row.latest_high }}">
              {% if row.latest_high %}<span class="high">{{ row.latest_high }}</span>{% else %}<span style="color:var(--text-muted)">—</span>{% endif %}
            </td>
            <td class="count-cell" data-val="{{ row.latest_medium }}">
              {% if row.latest_medium %}<span class="med">{{ row.latest_medium }}</span>{% else %}<span style="color:var(--text-muted)">—</span>{% endif %}
            </td>
            <td class="count-cell" data-val="{{ row.latest_total_findings }}">{{ row.latest_total_findings }}</td>
            <td>
              {%- set scores = row.trend_scores -%}
              {%- if scores | length > 1 -%}
              <svg class="sparkline" width="80" height="28" viewBox="0 0 80 28"
                   aria-label="Trend: {{ scores | join(', ') }}">
                {%- set n = scores | length -%}
                {%- set min_s = scores | min -%}
                {%- set max_s = scores | max -%}
                {%- set rng = (max_s - min_s) if max_s != min_s else 1 -%}
                {%- set pts = [] -%}
                {%- for i in range(n) -%}
                  {%- set x = (i / (n - 1) * 76 + 2) | round(1) -%}
                  {%- set y = (26 - ((scores[i] - min_s) / rng * 22)) | round(1) -%}
                  {%- if pts.append(x ~ "," ~ y) %}{% endif -%}
                {%- endfor -%}
                <polyline
                  points="{{ pts | join(' ') }}"
                  fill="none"
                  stroke="{% if scores[-1] >= 80 %}#16a34a{% elif scores[-1] >= 50 %}#d97706{% else %}#dc2626{% endif %}"
                  stroke-width="2"
                  stroke-linejoin="round"
                  stroke-linecap="round"/>
                <circle cx="{{ (76 + 2) | round(1) }}"
                        cy="{{ (26 - ((scores[-1] - min_s) / rng * 22)) | round(1) }}"
                        r="3"
                        fill="{% if scores[-1] >= 80 %}#16a34a{% elif scores[-1] >= 50 %}#d97706{% else %}#dc2626{% endif %}"/>
              </svg>
              {%- elif scores | length == 1 -%}
              <span style="font-size:12px;color:var(--text-muted)">{{ scores[0] }}</span>
              {%- else -%}
              <span style="font-size:12px;color:var(--text-muted)">—</span>
              {%- endif -%}
            </td>
            <td class="last-scan" data-val="{{ row.latest_captured_at }}">
              {{ row.latest_captured_at[:10] }}
            </td>
            <td>
              {% if row.report_path %}
              <a href="{{ row.report_path }}" target="_blank">report ↗</a>
              {% else %}
              <span style="color:var(--text-muted)">—</span>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
  </div>

  <div class="footer">
    Generated by <strong>ca-radar</strong>{% if tool_version %} v{{ tool_version }}{% endif %} &nbsp;·&nbsp;
    Read-only analysis — no data written to tenants
  </div>
</div>

<script>
/* ── Column sort ────────────────────────────────────────────────── */
let _sortCol = 1, _sortAsc = true;

function sortTable(col) {
  const table = document.getElementById('portfolio-table');
  const tbody = table.tBodies[0];
  const rows  = Array.from(tbody.rows);
  const headers = table.tHead.rows[0].cells;

  _sortAsc = (_sortCol === col) ? !_sortAsc : true;
  _sortCol = col;

  Array.from(headers).forEach((th, i) => {
    th.classList.remove('sorted-asc', 'sorted-desc');
    if (i === col) th.classList.add(_sortAsc ? 'sorted-asc' : 'sorted-desc');
  });

  rows.sort((a, b) => {
    const aVal = a.cells[col].dataset.val ?? a.cells[col].textContent.trim();
    const bVal = b.cells[col].dataset.val ?? b.cells[col].textContent.trim();
    const aNum = parseFloat(aVal), bNum = parseFloat(bVal);
    let cmp;
    if (!isNaN(aNum) && !isNaN(bNum)) {
      cmp = aNum - bNum;
    } else {
      cmp = aVal.localeCompare(bVal);
    }
    return _sortAsc ? cmp : -cmp;
  });
  rows.forEach(r => tbody.appendChild(r));
}
</script>
</body>
</html>
